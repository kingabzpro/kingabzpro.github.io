---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { Icon } from "astro-icon/components";
import * as about from "../content/about/about.md";

const title = `${about.frontmatter.name} - ${about.frontmatter.designation}`;
const description = "Official website of Abid Ali Awan. Data Scientist and Technical Writer building practical AI systems, production ML pipelines, and technical content.";
const sameAs = [
  "https://www.linkedin.com/in/1abidaliawan/",
  "https://github.com/kingabzpro",
  "https://kingabzpro.medium.com/",
  "https://www.datacamp.com/profile/kingabzpro",
  "https://huggingface.co/kingabzpro",
  "https://abid.work",
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://abidaliawan.com/#website",
      url: "https://abidaliawan.com/",
      name: "Abid Ali Awan",
      alternateName: "Abid Ali Awan - Data Scientist & Technical Writer",
      description,
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": "https://abidaliawan.com/#person",
      name: "Abid Ali Awan",
      url: "https://abidaliawan.com/",
      image: "https://abidaliawan.com/og-image.png",
      jobTitle: "Data Scientist & Technical Writer",
      description,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Islamabad",
        addressCountry: "Pakistan",
      },
      sameAs,
      knowsAbout: [
        "Data Science",
        "Machine Learning",
        "Natural Language Processing",
        "MLOps",
        "Large Language Models",
        "Technical Writing",
      ],
      contactPoint: [
        {
          "@type": "ContactPoint",
          contactType: "professional",
          url: "https://abidaliawan.com/#contact-form",
        },
      ],
    },
    {
      "@type": "ProfilePage",
      "@id": "https://abidaliawan.com/#profile",
      url: "https://abidaliawan.com/",
      name: "Abid Ali Awan",
      mainEntity: {
        "@id": "https://abidaliawan.com/#person",
      },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["#about", "header"],
      },
    },
    {
      "@type": "FAQPage",
      "@id": "https://abidaliawan.com/#faq",
      mainEntity: [
        {
          "@type": "Question",
          name: "What does Abid Ali Awan do?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Abid Ali Awan is a data scientist, AI engineer, and technical writer focused on end-to-end delivery: researching, building, testing, documenting, and publishing practical AI and data science systems. He works with companies like KDnuggets, DataCamp, Machine Learning Mastery, and Firecrawl.",
          },
        },
        {
          "@type": "Question",
          name: "How can I contact Abid Ali Awan for consulting or collaboration?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "You can reach Abid through the contact form on abidaliawan.com, via LinkedIn at linkedin.com/in/1abidaliawan, or by email through the contact section of his website.",
          },
        },
        {
          "@type": "Question",
          name: "Where is Abid Ali Awan based?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Abid Ali Awan is based in Islamabad, Pakistan. He works remotely with companies worldwide.",
          },
        },
        {
          "@type": "Question",
          name: "What companies has Abid Ali Awan worked with?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Abid has worked with KDnuggets as Staff Writer and Assistant Editor, DataCamp as Data Science Editor and Copywriter, Firecrawl as Technical Writer, Machine Learning Mastery as Technical Writer, Guidepoint as Data Science Consultant, and is the Co-Founder of NexusML.",
          },
        },
        {
          "@type": "Question",
          name: "What are Abid Ali Awan's areas of expertise?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Abid specializes in data science, machine learning, MLOps, large language models, natural language processing, model fine-tuning, technical writing, and production ML systems.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://abidaliawan.com/"
  structuredData={structuredData}
>
  <Header />
  <div
    class="theme-switcher absolute top-4 right-4 z-10 md:top-6 md:right-6 lg:top-8 lg:right-8 xl:top-10 xl:right-10"
  >
    <Icon name="carbon:moon" class="theme-switcher__icon h-5 w-5" />
    <label class="theme-switcher__track">
      <input
        type="checkbox"
        data-theme-toggle
        class="theme-switcher__input"
        aria-label="Toggle theme"
      />
      <span class="theme-switcher__thumb" aria-hidden="true"></span>
    </label>
    <Icon name="carbon:light" class="theme-switcher__icon h-5 w-5" />
  </div>

  <div
    class="divider mx-auto h-fit max-w-3xl w-[95vw] flex flex-nowrap bg-secondary"
  >
  </div>
  <main
    class="mx-auto flex-grow max-w-3xl py-2 grid w-[95vw]"
  >
    <div class="container">
      <Container />
    </div>
  </main>
  <Footer />
</BaseLayout>
